# Absolute origin of the deployed site. Required for production builds:
# drives metadataBase, canonical URLs, sitemap.xml and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://thekulaapp.com

# Optional. Search-console ownership tokens — the `content` value of the meta
# tag each console offers under "HTML tag" verification. Leave unset to emit
# no tag (e.g. when verifying Google through a DNS TXT record instead).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Contact form delivery (Resend — https://resend.com). Server-only; never
# prefix these with NEXT_PUBLIC_. Without RESEND_API_KEY the form tells
# senders to email the published address instead of pretending to send.
RESEND_API_KEY=
# Where messages land. Defaults to the published contact address.
CONTACT_TO_EMAIL=thekulaapp.info@gmail.com
# The sender. Leave blank to use Resend's test sender, which only delivers to
# the Resend account's own email. For production, verify thekulaapp.com in
# Resend and use e.g. "Kula Website <hello@thekulaapp.com>".
CONTACT_FROM_EMAIL=
